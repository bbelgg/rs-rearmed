# game.offline.no_network: the online stub and the crypto rewrites must not
# import anything that can reach a network (the game must never contact
# the network). Lists the undefined symbols of each library (every
# architecture slice) and fails on sockets, name resolution, URL/stream
# networking, TLS, curl, and the stubbed-out telemetry/browser helpers.
#   cmake -DLIBS="a.a|b.a" -P no_network.cmake
string(REPLACE "|" ";" libs "${LIBS}")
set(bad_re "^_(socket|socketpair|connect|connectx|bind|listen|accept|send|sendto|sendmsg|recv|recvfrom|recvmsg|getaddrinfo|freeaddrinfo|getnameinfo|gethostbyname|gethostbyname2|gethostbyaddr|res_query|res_search|dns_.*|curl_.*|SSL_.*|TLS_.*|SSLCreateContext|nw_.*|CFSocket.*|CFStreamCreatePairWithSocket.*|CFHost.*|CFNetwork.*|CFHTTP.*|CFURLCreateDataAndPropertiesFromResource|SCNetwork.*|SecTrust.*|sysctlbyname|system|popen|execv|execve|execvp|posix_spawn|posix_spawnp|fork)$|NSURL|NSStream")
if(NOT "_getaddrinfo" MATCHES "${bad_re}" OR NOT "_socket" MATCHES "${bad_re}")
  message(FATAL_ERROR "the pattern does not catch a plain socket import")
endif()
set(failed 0)
foreach(lib IN LISTS libs)
  execute_process(COMMAND nm -u -A ${lib} OUTPUT_VARIABLE out RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "nm failed on ${lib}")
  endif()
  string(REPLACE "\n" ";" lines "${out}")
  set(syms "")
  foreach(line IN LISTS lines)
    string(REGEX MATCH "[^ ]+$" sym "${line}")
    if(sym STREQUAL "")
      continue()
    endif()
    list(APPEND syms "${sym}")
    if(sym MATCHES "${bad_re}")
      message("NETWORK IMPORT: ${line}")
      set(failed 1)
    endif()
  endforeach()
  list(REMOVE_DUPLICATES syms)
  list(SORT syms)
  list(LENGTH syms n)
  get_filename_component(name "${lib}" NAME)
  string(REPLACE ";" " " joined "${syms}")
  message("${name}: ${n} imported symbols: ${joined}")
endforeach()
if(failed)
  message(FATAL_ERROR "network imports found")
endif()
message("no network imports")
