# --- Seven-String Guitar: end
# --- Frame rate (built in: tools/ws7/recomp/overrides/mods/framerate.c): what the game counts in frames, as at 60 Hz
fps_calib_window      # calibration's start: its averaging window, before it is stored
fps_calib_step_play   # calibration, strings played: the level's step of this frame, before it is added
fps_calib_step_mute   # calibration, strings muted: the same
fps_panel_hold        # a menu panel's hold: what this frame takes off its timer
fps_tuner_miss        # the tuner's string hold: the misses in a row, where they are compared with three, and where fewer go on
fps_tuner_volume      # the tuner's volume warnings: the check's start, and its return
fps_tuner_instrument  # the tuner's wrong instrument warning: the same
fps_tuner_hint        # the tuner's first-time hint: the same
# --- Skip Tuner in the Guitarcade (built in: tools/ws7/recomp/overrides/mods/mods_shared.c)
tuner_skip_offer      # the tuner menu's buttons: whether Skip Tuner is offered, where the game acts on it
# --- Batched DLC mounting (built in: tools/ws7/recomp/overrides/mods/mods_shared.c)
manifest_request      # the ManifestManager has asked for a mounted archive's song manifest (a .hsan or .hson file)
manifest_response     # the ManifestManager is handed the answer to one such request, read or failed
fs_mount              # an archive is about to join the game's file system: where, and the archive
fs_exists             # the game asks its file system whether a file is there; a hook may answer in its place
# --- Stock-game fixes (built in: tools/ws7/recomp/overrides/mods/mods_shared.c): the white loading screen
menu_request          # a menu movie's request to the asset locator: the movie and the request's id, at the function's start
menu_locate           # the request is about to ask the locator (not when the movie has no name)
menu_located          # the locator has answered: accepted or not
file_indexed          # a file is in the local file index (or was already), its lock released: on the indexing threads
# --- Stock-game fixes: Learn a Song with more than five arrangements
las_alt_slot          # the Learn a Song page's builder, at an alternate arrangement: the slots filled so far, and where to skip it
