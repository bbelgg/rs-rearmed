# Game functions and globals native code calls or reads without overriding them, by the module that uses
# them (paths under tools/ws7/recomp/).

# mods (overrides/mods/mods.c)
scaleform_keycode_table  # macOS keycode -> Scaleform key
game_char_to_key         # character -> KEY_* index
game_key_state           # KEY_* state array
thread_priority_table    # engine thread priorities
path_table_lock          # recursive mutex of the interned path table
path_table               # the interned path table
path_intern              # interned refcounted path object (+1 reference); len -1 = strlen
path_release             # drops a path object reference
dlc_update_head          # first call of the DLC coordinator's update
dlc_install_step         # mounts one pending archive, or clears the installing flag
dlc_enum_check           # DLC coordinator check (clears the pending flags when true)
dlc_update_tail          # DLC coordinator follow-up
std_tree_destroy         # std::map node destruction
json_number_table        # global table of JSON number values
json_number_table_lock   # its recursive mutex
json_number_vtable       # number object vtable
const_two_pow_63         # 2^63
hashtable_prime_sizes    # table sizes, lower_bound'ed by rehash
efd_alloc                # efd allocator
json_number_base_ctor    # number object base constructor
json_number_base_dtor    # number object base destructor
sng_load_verify_ret      # SNG loader: return address of its DSA verify call
input_mode               # (int player) -> u8: 0 Real Tone cable, 1 microphone, 2 disconnected, 3 Direct Connect, 4 not set
input_profile_string     # (int player, const char *key, string *out): a string of the player's profile
input_manager            # () -> SoundInput manager
input_by_name            # (manager, const char *name) -> the input of that name, or null
input_binding            # int[10]: what each slot serves: 0-3 an input, 5 nothing
input_key_direct         # const char *: profile key of the Direct Connect input's name
input_key_mic            # const char *: profile key of the microphone's name
autosave_signin_query    # object answering the sign-in predicate gating the Auto Save dialog
autosave_query_arg       # int argument (1) of that predicate
input_mode_restore       # (ServiceManager): restores player 0's cached input mode and applies it, before the Auto Save dialog

# audio (overrides/src/audio_*.c)
ak_platform_settings   # Wwise's AkPlatformInitSettings copy
ak_init                # AK::SoundEngine::Init
ak_sink_ring_alloc     # CoreAudio sink: allocates the ring
si_open                # SoundInput slot open
si_io                  # SoundInput I/O: one buffer of an input
audio_mono_to_stereo   # [Audio] MonoToStereoChannel as the game read it: 1 = a two-channel input's second channel
ak_lengine_thread_id   # pthread_t of the LEngine thread
ak_lengine_start_time  # time(0) at LEngine thread start
ak_render_loop         # renders the blocks the sink needs
ak_render_engine       # its argument

# dsp (overrides/src/dsp_glue.c)
la_vcosf    # __la_symbol_ptr slot of _vcosf
dsp_two_pi  # 2pi
dsp_two     # 2
dsp_ramp0   # {0, 1, 2, 3}
dsp_half4   # {0.5 x4}
dsp_four4   # {4 x4}
dsp_k046    # {0.46 x4}
dsp_k054    # {0.54 x4}
dsp_one4    # {1 x4}

