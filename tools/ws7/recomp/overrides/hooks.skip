# Hook points (gen_image.py --skip, `ADDR wrap`): the function is translated as W_ADDR and F_ADDR runs the
# hooks registered at run time around it (runtime/rc_hook.h), by the mods the game loads from the mods folder
# (app/rc_main.c). A point without hooks costs one call. Add points here; removing one breaks a mod that
# hooks it (and needs a new release).
10017a020 wrap  # game_frame          GameFrame() -> bool quit: once per frame on the game thread
100ba1190 wrap  # input_sink          (int code, int a, int b): input events, code 0/1 = key down/up, a = key code
100ab2c60 wrap  # ak_post_event_name  AK::SoundEngine::PostEvent(const char *, ...)
100315220 wrap  # too_many_inputs     (input manager) -> bool: a second guitar input is active; only for the "two cables" popup
1000e1e70 wrap  # set_app_focus       SetAppFocus(bool): focus gained / lost (pauses audio)
100314f70 wrap  # ui_event            (menu, int event, int arg): UI events; the shell sends 0x98 (pause) on focus loss
1002ddd70 wrap  # rr_speed_ratio      float (float slider percent): Riff Repeater slider -> song speed ratio
100ab1b20 wrap  # ak_set_rtpc_name    AK::SoundEngine::SetRTPCValue(const char *, float, unsigned long long, int, AkCurveInterpolation)
100e438c0 wrap  # camera_set_frustum  NiCamera::SetViewFrustum(const NiFrustum &): every camera, every frame
100ab0a30 wrap  # ak_init             AK::SoundEngine::Init(AkInitSettings *, AkPlatformInitSettings *): +0x54 = refills (LatencyBuffer); audio_ring.c
10133bee0 wrap  # si_open             SoundInput open (this, int slot) -> bool: opens device list entry `slot` as a guitar input; audio_trace.c
